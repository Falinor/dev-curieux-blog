---
import { CF_BEACON_TOKEN } from 'astro:env/server';

// Cloudflare Web Analytics: cookieless page views. The beacon is only on the
// pages of a build that has a token, so local and preview builds don't count.
---

{CF_BEACON_TOKEN && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
  />
)}
