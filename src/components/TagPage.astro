---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Locale, tagPath, ui } from '../lib/i18n';
import { tagLabel, type TaggedPosts } from '../lib/posts';
import Postcard from './Postcard.astro';
import PostcardGrid from './PostcardGrid.astro';
import TitleCard from './TitleCard.astro';

// A Tag's page: `/tags/<id>/` in French, `/en/tags/<id>/` in English. A title
// card over the horizon names the Tag in that language; below it, the Posts
// that language's pages show, newest first, as postcards.

interface Props extends TaggedPosts {
  locale: Locale;
}

const { locale, tag, views } = Astro.props;
const label = tagLabel(tag, locale);
const words = ui[locale].tag;
---

<BaseLayout
  title={words.title(label)}
  description={words.description(label)}
  alternates={{ fr: tagPath('fr', tag.id), en: tagPath('en', tag.id) }}
>
  <main class="page">
    <TitleCard class="title">
      <h1>{label}</h1>
      <p class="lead">{words.description(label)}</p>
    </TitleCard>
    {views.length > 0 ? (
      <PostcardGrid>
        {views.map((view) => (
          <Postcard view={view} level={2} />
        ))}
      </PostcardGrid>
    ) : (
      <p>{ui[locale].noPosts}</p>
    )}
  </main>
</BaseLayout>

<style>
  .title {
    max-width: 740px;
    margin-inline: auto;
    margin-bottom: 56px;
  }
  h1 {
    margin: 0 0 10px;
  }
</style>
