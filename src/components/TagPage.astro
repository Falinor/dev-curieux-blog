---
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Locale, postPath, tagPath, ui } from '../lib/i18n';
import type { TaggedPosts } from '../lib/posts';

// A Tag's page: `/tags/<id>/` in French, `/en/tags/<id>/` in English, titled
// with the Tag's label in that language. It lists the Posts that language's
// pages show, newest first.

interface Props extends TaggedPosts {
  locale: Locale;
}

const { locale, tag, views } = Astro.props;
const label = tag.data[locale];
const words = ui[locale].tag;
---

<BaseLayout
  title={words.title(label)}
  description={words.description(label)}
  alternates={{ fr: tagPath('fr', tag.id), en: tagPath('en', tag.id) }}
>
  <main>
    <h1>{label}</h1>
    {views.length > 0 ? (
      <ul>
        {views.map(({ post, entry }) => (
          <li>
            <a href={postPath(locale, post.id)}>{entry.data.title}</a>
          </li>
        ))}
      </ul>
    ) : (
      <p>{ui[locale].noPosts}</p>
    )}
  </main>
</BaseLayout>

<style>
  /* On the sea, a link takes the sea's text color: `link` only reads on cards. */
  a {
    color: var(--sea-text);
  }
</style>
