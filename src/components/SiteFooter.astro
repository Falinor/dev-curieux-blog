---
import { pageLocale, ui } from '../lib/i18n';

// The legal pages live on the landing page, in French; they cover the blog too.
const year = new Date().getFullYear();
const words = ui[pageLocale(Astro.currentLocale)];
---

<footer class="page">
  <p>
    © {year} Dev curieux{' · '}
    <a href="https://curieux.dev/mentions-legales" hreflang="fr">
      {words.legalNotice}
    </a>
    {' · '}
    <a href="https://curieux.dev/confidentialite" hreflang="fr">
      {words.privacy}
    </a>
  </p>
  <p>{words.tagline}</p>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 56px;
    padding-block: 18px 32px;
    border-top: var(--outline);
    color: var(--sea-text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }
</style>
