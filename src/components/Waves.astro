---
import { waveBox, waves } from '../lib/waves';

// The sea at the bottom of the scene: three outlined waves, back to front. Each
// is an SVG twice as wide as the scene whose curve repeats every half width, so
// sliding it by half its width loops without a seam.
const { width, height } = waveBox;
---

{waves.map(({ name, fill, d }) => (
  <svg
    class:list={['wave', name]}
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path d={d} fill={`var(--${fill})`} />
  </svg>
))}

<style>
  .wave {
    position: absolute;
    bottom: 0;
    left: 0;
    /* At least twice the scene, and wide enough that phone waves aren't squeezed. */
    width: max(200%, 1600px);
    height: 90px;
  }
  path {
    stroke: var(--edge);
    stroke-width: 3px;
    vector-effect: non-scaling-stroke;
  }

  /* The back and middle waves drift, unless the reader asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    .back {
      animation: wave-drift 26s linear infinite reverse;
    }
    .middle {
      animation: wave-drift 18s linear infinite;
    }
  }
  @keyframes wave-drift {
    to {
      transform: translateX(-50%);
    }
  }
</style>
