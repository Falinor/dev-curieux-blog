---
import { formatDate, isoDate } from '../lib/dates';
import { getPostTags, readingMinutes, type Post } from '../lib/posts';

// A Post as readers see it: a title postcard overlapping the horizon of the
// scene, then the body (the default slot) on a sheet.

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt } = post.data;
const tags = await getPostTags(post);
---

<article>
  <header class="title-card">
    <p class="meta">
      <span>
        Publié le <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
      </span>
      {updatedAt && (
        <span>
          Mis à jour le <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt)}</time>
        </span>
      )}
      <span>{readingMinutes(post.body)} min de lecture</span>
    </p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <ul class="chips" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag.id}/`}>
            <span aria-hidden="true">#</span>
            {tag.data.fr}
          </a>
        </li>
      ))}
    </ul>
  </header>
  <div class="sheet">
    <slot />
  </div>
</article>

<style>
  article {
    position: relative;
    max-width: 820px;
    /* The title postcard overlaps the horizon, over the waves. */
    margin: -70px auto 0;
  }

  .title-card {
    padding: 26px 28px;
    background: var(--card);
    color: var(--ink);
    border: var(--outline);
    box-shadow: var(--shadow-lg);
    transform: rotate(-1deg);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  h1 {
    margin: 8px 0 12px;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0;
    color: var(--muted);
    font-size: 1.12rem;
  }
  /* Tag chips: stickers, like the header's. */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips a {
    display: block;
    padding: 1px 8px;
    background: var(--sun);
    color: var(--on-sun);
    border: var(--outline);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .chips a:hover {
    text-decoration: underline;
  }

  .sheet {
    margin-top: 34px;
    padding: clamp(20px, 4vw, 44px);
    background: var(--card);
    color: var(--ink);
    border: var(--outline);
    box-shadow: var(--shadow-lg);
  }
</style>
