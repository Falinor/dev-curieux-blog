---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { type Alternates, postPath, socialImagePath } from '../lib/i18n';
import { getPostTags, type PostView } from '../lib/posts';
import PostArticle from './PostArticle.astro';

// A Post's page: `/<slug>/` in French, `/en/<slug>/` for its Translation.

interface Props {
  view: PostView;
  alternates: Alternates | undefined;
}

const { view, alternates } = Astro.props;
const { locale, post, text } = view;
const { title, description } = text.data;
const article = {
  headline: title,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  tags: (await getPostTags(post)).map((tag) => tag.data[locale]),
};
const { Content } = await render(text);
---

<BaseLayout
  title={`${title} — Dev curieux`}
  description={description}
  alternates={alternates}
  image={socialImagePath(postPath(locale, post.id))}
  article={article}
>
  <main class="page">
    <PostArticle view={view}>
      <Content />
    </PostArticle>
  </main>
</BaseLayout>
