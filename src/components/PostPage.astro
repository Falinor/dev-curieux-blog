---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Alternates } from '../lib/i18n';
import type { PostView } from '../lib/posts';
import PostArticle from './PostArticle.astro';

// A Post's page: `/<slug>/` in French, `/en/<slug>/` for its Translation.

interface Props {
  view: PostView;
  alternates: Alternates | undefined;
}

const { view, alternates } = Astro.props;
const { title, description } = view.text.data;
const { Content } = await render(view.text);
---

<BaseLayout title={`${title} — Dev curieux`} description={description} alternates={alternates}>
  <main class="page">
    <PostArticle view={view}>
      <Content />
    </PostArticle>
  </main>
</BaseLayout>
