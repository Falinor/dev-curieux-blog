---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { postPath, socialImagePath } from '../lib/i18n';
import { getTagLabels, type PostPageContent } from '../lib/posts';
import PostArticle from './PostArticle.astro';

// A Post's page: `/<slug>/` in French, `/en/<slug>/` for its Translation.

type Props = PostPageContent;

const { view, alternates } = Astro.props;
const { locale, post, entry } = view;
const { title, description } = entry.data;
const meta = {
  headline: title,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  tags: await getTagLabels(view),
};
const { Content } = await render(entry);
---

<BaseLayout
  title={`${title} — Dev curieux`}
  description={description}
  alternates={alternates}
  image={socialImagePath(postPath(locale, post.id))}
  post={meta}
>
  <main class="page">
    <PostArticle view={view}>
      <Content />
    </PostArticle>
  </main>
</BaseLayout>
