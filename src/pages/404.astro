---
import ButtonLink from '../components/ButtonLink.astro';
import Stamp from '../components/Stamp.astro';
import TitleCard from '../components/TitleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homePath, ui } from '../lib/i18n';

// Served for every unknown URL, with a 404 status: by `astro preview`, and by
// Workers static assets (`not_found_handling: "404-page"` in wrangler.jsonc).
// Both serve one page, so it is in French. A postcard sent back: it overlaps
// the horizon like a Post's title card. Search engines must not index it
// (`noindex`).
const words = ui.fr.notFound;
---

<BaseLayout title={words.title} description={words.lead} noindex>
  <main class="page">
    <TitleCard class="card">
      <p class="postmark">{words.postmark}</p>
      <Stamp class="status">404</Stamp>
      <h1>{words.heading}</h1>
      <p class="lead">{words.lead}</p>
      <ButtonLink class="home" href={homePath('fr')}>
        {words.home}
      </ButtonLink>
    </TitleCard>
  </main>
</BaseLayout>

<style>
  .card {
    display: grid;
    grid-template:
      'postmark stamp' auto
      'title stamp' auto
      'lead lead' auto
      'home home' auto
      / minmax(0, 1fr) auto;
    gap: 14px 20px;
    max-width: 680px;
    margin-inline: auto;
  }

  /* The post office's rubber stamp on mail it can't deliver. */
  .postmark {
    grid-area: postmark;
    justify-self: start;
    margin: 0;
    padding: 2px 10px;
    border: 2px solid currentColor;
    border-radius: 4px;
    color: var(--coral-text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-3deg);
  }

  .status {
    grid-area: stamp;
    font-size: 1.1rem;
  }

  h1 {
    grid-area: title;
    margin: 0;
  }

  .lead {
    grid-area: lead;
    max-width: 52ch;
  }

  /* The page's one way out: a bigger button. */
  .home {
    grid-area: home;
    justify-self: start;
    margin-top: 8px;
  }
  .card .home {
    padding: 8px 16px;
  }
</style>
