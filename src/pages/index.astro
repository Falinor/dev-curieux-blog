---
import Postcard from '../components/Postcard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, homeLayout } from '../lib/posts';

const { featured, others } = homeLayout(await getPublishedPosts());
---

<BaseLayout title="Dev curieux — le blog">
  <div class="hero" slot="hero">
    <h1>
      Cartes postales d’un dev <span class="highlight">curieux</span>
    </h1>
    <p>Développeur fullstack freelance. Je construis, j’apprends, et j’écris ce que je découvre.</p>
  </div>
  <main class="page">
    <section id="posts" aria-labelledby="posts-title">
      <h2 id="posts-title">Dernières nouvelles</h2>
      <ol class="postcards">
        {featured.map((post) => (
          <Postcard post={post} featured />
        ))}
        {others.map((post) => (
          <Postcard post={post} />
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  .hero {
    padding-top: 40px;
  }
  h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  /* A sticker on the word that names the blog. */
  .highlight {
    display: inline-block;
    padding: 0 0.15em;
    background: var(--sun);
    color: var(--on-sun);
    border: var(--outline);
    box-shadow: var(--shadow-sm);
    transform: rotate(-2deg);
  }
  .hero p {
    max-width: 34ch;
    margin: 14px 0 0;
    font-size: 1.1rem;
  }

  section {
    padding-block: 40px 24px;
  }
  h2 {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }
  /* At most two postcards per row: one on phones. */
  .postcards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .postcards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
