---
import Postcard from '../components/Postcard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, homeLayout } from '../lib/posts';

const { featured, others } = homeLayout(await getPublishedPosts());
---

<BaseLayout title="Dev curieux — le blog">
  <main class="page">
    <section id="posts" aria-labelledby="posts-title">
      <h2 id="posts-title">Dernières nouvelles</h2>
      <ol class="postcards">
        {featured.map((post) => (
          <Postcard post={post} featured />
        ))}
        {others.map((post) => (
          <Postcard post={post} />
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  section {
    padding-block: 40px 24px;
  }
  h2 {
    margin: 0 0 22px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
  }
  /* At most two postcards per row: one on phones. */
  .postcards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 34px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .postcards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
