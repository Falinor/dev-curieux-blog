---
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Seo, { type Props as SeoProps } from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { homePath, otherLocale, pageLocale } from '../lib/i18n';
import '../styles/global.css';

// Every page's frame. The page names itself to search engines through the
// `Seo` props: title, description, and its path in both languages when it
// exists in both (`alternates`).
type Props = SeoProps;

const { alternates } = Astro.props;
const locale = pageLocale(Astro.currentLocale);
// The same page in the other language, or that language's home page when the
// page has no counterpart (a Post without a Translation, the 404 page).
const other = otherLocale(locale);
const counterpart = alternates?.[other] ?? homePath(other);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <SiteHeader languageSwitch={counterpart}>
      <slot name="hero" />
    </SiteHeader>
    <slot />
    <SiteFooter />
    <Analytics />
  </body>
</html>
