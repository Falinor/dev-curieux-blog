{
  // Cloudflare Workers static assets: serves the Astro build output, no Worker script.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dev-curieux-blog",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "blog.curieux.dev", "custom_domain": true }],
}
